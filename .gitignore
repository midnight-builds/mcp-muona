# dependencies (bun install)
node_modules

# output
out
dist
*.tgz

# code coverage
coverage
*.lcov

# logs
logs
*.log
report.[0-9]_.[0-9]_.[0-9]_.[0-9]_.json

# dotenv environment variable files (secrets: MCP_AUTH_TOKEN, OAuth, API keys)
.env
.env.*
!.env.example

# caches
.eslintcache
.cache
*.tsbuildinfo

# editors and OS
.idea
.vscode
.DS_Store

# local agent state and session notes (never versioned)
.claude/
.paseo/
handoffs/

# browser persistent data — the S-Etukortti profile is equivalent to live
# login credentials (S-tunnus SSO cookies)
.browser-data/
.browser-data-*/

# screenshots from exploration (may show personal data, captcha images)
screenshots/

# playwright-cli artifacts
.playwright-cli/
snapshots/
test-results/
playwright-report/

# HAR captures (may contain session data)
har/
*.har

# temporary API capture dumps (real personal data)
data-capture/

# local purchase-history SQLite database and S-ostoslista tokens
data/
*.sqlite
*.sqlite-*
*.db

# private keys and certificates
*.pem
*.key
