# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# OAuth client credentials (for claude.ai and other MCP clients)
# Generate with: openssl rand -hex 32
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
PORT=3001

# S-Etukortti receipts
# Browser profile holding the manual OTP login session (default: .browser-data-s-etukortti/)
S_ETUKORTTI_DATA_DIR=

# Session keepalive interval in hours (default 6, clamped 1-24)
S_ETUKORTTI_KEEPALIVE_HOURS=

# Local purchase-history SQLite database path (default: <repo>/data/receipts.sqlite)
MUONA_DB_PATH=
