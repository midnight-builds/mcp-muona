{
	"name": "muona",
	"module": "src/index.ts",
	"type": "module",
	"private": true,
	"bin": {
		"muona": "src/index.ts"
	},
	"scripts": {
		"dev": "bun run --watch src/index.ts",
		"build": "bun build src/index.ts --outdir dist --target bun --packages external",
		"start": "bun run dist/index.js",
		"login": "bun run scripts/s-etukortti-login.ts",
		"sync": "bun run scripts/sync-receipts.ts",
		"reparse": "bun run scripts/reparse-receipts.ts",
		"test": "bun test",
		"test:e2e": "bun test ./e2e/smoke.test.ts",
		"check": "bunx biome check --write . && bun run scripts/check-dividers.ts",
		"lint": "bunx biome ci . && bun run scripts/check-dividers.ts",
		"typecheck": "bunx tsc --noEmit",
		"prepare": "git config core.hooksPath .githooks || true",
		"deploy": "scripts/deploy.sh"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@types/bun": "latest"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.2",
		"pino": "^10.4.0",
		"playwright": "^1.64.1",
		"playwright-extra": "^4.3.6",
		"puppeteer-extra-plugin-stealth": "^2.11.2",
		"zod": "^4.6.7"
	}
}
