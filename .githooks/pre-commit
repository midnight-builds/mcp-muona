#!/usr/bin/env sh
# Fast gates only; tests and build run in CI so this hook stays cheap enough
# that nobody reaches for --no-verify.
set -e
bunx biome check --staged --no-errors-on-unmatched
git diff --cached --name-only -z --diff-filter=ACMR -- '*.ts' |
	xargs -0 -r bun run scripts/check-dividers.ts
bun run typecheck
